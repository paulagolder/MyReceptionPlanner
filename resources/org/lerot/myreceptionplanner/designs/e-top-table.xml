<?xml version="1.0" encoding="UTF-8"?>
<!--
  An E: a top table of 13 (six 2 x 1 tables and a 1 x 1), with three prongs
  of four 1 x 2 tables, two of them flush with its ends, seated on both
  sides. 61 places. Take "near" out of the top table's bare sides to seat
  its inside as well (67 places).

  Sizes are in seats (60 cm a seat), as the table is placed: "2 1" is two
  seats along and one across. Each <tables> is a line of count tables from
  "at" (from the top left), going right or down. "bare" names the sides with
  no seats: far, near, left, right. Where two seated edges make an inside
  corner, the later seat round the table is left out.
  See docs/table-notation.md.
-->
<table shape="composed" head="true">
  <tables size="2 1" count="3" at="0 0" bare="near left"/>
  <tables size="1 1" at="6 0" bare="near"/>
  <tables size="2 1" count="3" at="7 0" bare="near right"/>
  <tables size="1 2" count="4" at="0 1" going="down" bare="near"/>
  <tables size="1 2" count="4" at="6 1" going="down" bare="near"/>
  <tables size="1 2" count="4" at="12 1" going="down" bare="near"/>
</table>
