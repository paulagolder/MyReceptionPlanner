  <menu>
    <note>
      <line t="A banquet for the union of two houses, after Bartolomeo Scappi, who is cooking it himself."/>
      <line t="Four services, credenza and kitchen in turn, with music between them."/>
      <line t="The peacock is a capon roasted and sent to table in the peacock's own skin and feathers."/>
      <line t="Wines of Valpolicella and Soave, and Recioto with the sweets; hippocras and confetti to close."/>
      <line t="Almonds, sugar and sweet spices dress many dishes: ask the steward if in doubt."/>
    </note>
    <course name="First credenza: cold dishes">
      <dish id="1" name="Salted ox tongue with mostarda of quince" suits="gf df nf"/>
      <dish id="2" name="Eel of Lake Garda, marinated with bay and orange" suits="gf df nf"/>
      <dish id="3" name="Parmigiano with pears and honey" suits="v gf nf"/>
      <dish id="4" name="Salad of rocket, purslane and pomegranate" suits="v vg gf df nf"/>
    </course>
    <course name="First service from the kitchen: roasts">
      <dish id="5" name="Peacock re-dressed in its feathers, with royal sauce" suits="df nf"/>
      <dish id="6" name="Suckling pig from the spit, with apples and fennel" suits="gf df nf"/>
      <dish id="7" name="Venison of the Lessini hills with juniper" suits="gf df nf"/>
      <dish id="8" name="Roast pumpkin with sage and verjuice" suits="v vg gf df nf"/>
    </course>
    <course name="Second service from the kitchen">
      <dish id="9" name="Pasticcio of pigeons, sweetbreads and truffles" suits="nf"/>
      <dish id="10" name="Sturgeon of the Po, poached, with saffron sauce" suits="gf df nf"/>
      <dish id="11" name="Gnocchi of Verona with butter, sugar and cinnamon" suits="v nf"/>
      <dish id="12" name="Rice of the Veronese plain with peas and herbs" suits="v vg gf df nf"/>
    </course>
    <course name="Second credenza: sweets and fruit">
      <dish id="13" name="The Arena of Verona in sugar and marzipan" suits="v vg gf df"/>
      <dish id="14" name="Nadalin, the star-shaped sweet bread of Verona" suits="v nf"/>
      <dish id="15" name="Pears poached in Recioto with cinnamon" suits="v vg gf df nf"/>
      <dish id="16" name="Candied citron and quince paste" suits="v vg gf df nf"/>
    </course>
  </menu>
